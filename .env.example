# ───────────────────────────────────────────────────────────────────────
# CAELINUS — environment template
# ───────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in the secrets. `.env.local` is
# git-ignored and must NEVER be committed. If a key ever leaks (typed
# into a chat, a screenshot, a public log) — ROTATE IT IMMEDIATELY in
# the provider's dashboard before anything else.
#
# Three buckets:
#   1) PUBLIC          — NEXT_PUBLIC_*    bundled into the browser
#   2) SERVER SECRETS  — *_KEY etc.       only readable on the server
#   3) BUILD-TIME      — TTS, audio       only used by scripts/
#
# Validation: lib/env.ts will fail the production build if any required
# value below is missing. Local dev runs with placeholders + a warning.
# ───────────────────────────────────────────────────────────────────────


# ─── Site ─────────────────────────────────────────────────────────────
# Absolute base URL. Used to build OAuth callbacks, OG images, RSS
# links, and email magic-link URLs. In production set this to your
# canonical https domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ─── Supabase (auth + database + storage) ─────────────────────────────
# Create a project at https://supabase.com → Project Settings → API.
# `URL` is the project ref endpoint; `ANON_KEY` is safe to ship in the
# browser (RLS protects the data); `SERVICE_ROLE_KEY` bypasses RLS and
# must NEVER reach the client bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ─── Caelinus admin allow-list ────────────────────────────────────────
# Comma-separated list of emails granted access to /atelier/admin
# (atelier review queue, content moderation, sanctum exports).
# Lower-cased on read. Example:
#   CAELINUS_ADMIN_EMAILS=ada@caelinus.world, selin@caelinus.world
CAELINUS_ADMIN_EMAILS=


# ─── ElevenLabs (build-time TTS for /universe/gaia/plants) ────────────
# Used only by scripts/generate-plant-audio.mjs. The browser never sees
# this key — generated MP3s are static assets in /public/audio/plants.
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=

# Optional model override; falls back to eleven_multilingual_v2.
# ELEVEN_MODEL_ID=eleven_multilingual_v2


# ─── /play studio · AI image generation ───────────────────────────────
# The Play studio (`/play`) generates a goddess look from
# (archetype × zodiac × scene). Renders are cached in `play_renders`,
# so each unique triple costs at most one provider call EVER.
#
# Three providers — pick one with PLAY_AI_PROVIDER:
#
#   • stub      — local SVG placeholder. No key needed. Default. Use
#                 this for UI-only work, demos, screenshots.
#
#   • replicate — production. Cheap (~$0.003 per SDXL render),
#                 ~10–25s per call. Sign up at https://replicate.com
#                 → Settings → API tokens. Set PLAY_AI_API_KEY to your
#                 `r8_...` token.
#
#   • openai    — gpt-image-1, no polling. ~$0.02 per 1024×1024 image.
#                 https://platform.openai.com/api-keys → set
#                 PLAY_AI_API_KEY to a `sk-...` token.
#
# Cost guard: lib/play/rate-limit.ts allows 60 fresh renders / IP / hour
# (cache hits don't count). Tune `PLAY_AI_HOURLY_BUDGET` if you need
# tighter limits during a public demo.
#
# PLAY_AI_PROVIDER=stub
# PLAY_AI_API_KEY=
# PLAY_AI_REPLICATE_MODEL=stability-ai/sdxl:39ed52f2a78e934b3ba6e2a89f5b1c712de7dfea535525255b1aa35c5565e08b
# PLAY_AI_HOURLY_BUDGET=60


# ─── Transactional email · Resend ─────────────────────────────────────
# Used to notify atelier owners when their application is approved or
# returned for revisions. Without RESEND_API_KEY the sender falls back
# to a structured console log — the app keeps working in dev/CI.
#
# Setup:
#   1) Sign up at https://resend.com → Domains → "Add Domain", verify
#      DNS records (Resend gives you the exact lines to paste).
#   2) API Keys → "Create API Key" with the "Sending access" scope.
#   3) EMAIL_FROM must use a sender on the verified domain. Until your
#      domain is verified, "Caelinus <onboarding@resend.dev>" works for
#      testing but only delivers to the address that owns the Resend
#      account.
#
# RESEND_API_KEY=
# EMAIL_FROM="Caelinus <hello@mail.caelinus.world>"
