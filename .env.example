# ───────────────────────────────────────────────────────────────────────
# CAELINUS — environment template
# ───────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in the secrets. `.env.local` is
# git-ignored and must NEVER be committed. If a key ever leaks (typed
# into a chat, a screenshot, a public log) — ROTATE IT IMMEDIATELY in
# the provider's dashboard before anything else.
#
# Three buckets:
#   1) PUBLIC          — NEXT_PUBLIC_*    bundled into the browser
#   2) SERVER SECRETS  — *_KEY etc.       only readable on the server
#   3) BUILD-TIME      — TTS, audio       only used by scripts/
#
# Validation: lib/env.ts will fail the production build if any required
# value below is missing. Local dev runs with placeholders + a warning.
# ───────────────────────────────────────────────────────────────────────


# ─── Site ─────────────────────────────────────────────────────────────
# Absolute base URL. Used to build OAuth callbacks, OG images, RSS
# links, and email magic-link URLs. In production set this to your
# canonical https domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ─── Supabase (auth + database + storage) ─────────────────────────────
# Create a project at https://supabase.com → Project Settings → API.
# `URL` is the project ref endpoint; `ANON_KEY` is safe to ship in the
# browser (RLS protects the data); `SERVICE_ROLE_KEY` bypasses RLS and
# must NEVER reach the client bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ─── Caelinus admin allow-list ────────────────────────────────────────
# Comma-separated list of emails granted access to /atelier/admin
# (atelier review queue, content moderation, sanctum exports).
# Lower-cased on read. Example:
#   CAELINUS_ADMIN_EMAILS=ada@caelinus.world, selin@caelinus.world
CAELINUS_ADMIN_EMAILS=


# ─── ElevenLabs (build-time TTS for /universe/gaia/plants) ────────────
# Used only by scripts/generate-plant-audio.mjs. The browser never sees
# this key — generated MP3s are static assets in /public/audio/plants.
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=

# Optional model override; falls back to eleven_multilingual_v2.
# ELEVEN_MODEL_ID=eleven_multilingual_v2
